# Salin file ini menjadi ".env" lalu isi nilainya.

# Email anggota tim yang menjadi ADMIN (pisahkan dengan koma)
ADMIN_EMAILS=anggota1@gmail.com,anggota2@gmail.com

# Kode rahasia untuk mendaftar akun admin dengan email + password
ADMIN_KODE=ganti-dengan-kode-rahasia

# (Opsional) Client ID Google untuk tombol "Lanjutkan dengan Google"
GOOGLE_CLIENT_ID=

PORT=3000
